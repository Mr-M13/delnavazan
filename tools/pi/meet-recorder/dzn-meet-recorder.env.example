# Delnavazan Meet recording companion configuration.
# This file is a secret: keep it root-owned, mode 0600, outside the web root.
# The token must equal the platform option `dzn_meet_recorder_token` (or the
# DZN_MEET_RECORDER_TOKEN constant) on the WordPress host.

DZN_BASE_URL=https://delnavazan.com
DZN_RECORDER_TOKEN=replace-with-the-platform-token
DZN_CDP_URL=http://127.0.0.1:9222
DZN_POLL_SECONDS=5
DZN_JOIN_TIMEOUT=75
DZN_LEAVE_AFTER=120
