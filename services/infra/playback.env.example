# /etc/delnavazan/playback.env — root-only, mode 0600.
DZN_PLAYBACK_ISSUER=https://delnavazan.com/
DZN_PLAYBACK_KEYS={"dzn-playback-v1":"REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES"}
DZN_ARCHIVE_ROOT=/mnt/mbox/DelnavazanRecordings
DZN_ARCHIVE_MOUNT_MARKER=/mnt/mbox/.delnavazan-mount
DZN_PLAYBACK_RUNTIME_DIR=/run/delnavazan-playback
DZN_PLAYBACK_ACCESS_LOG=/var/log/delnavazan/playback-access.jsonl
# Bind to the OVH Tailscale address, never 0.0.0.0 and never a public interface.
DZN_PLAYBACK_BIND=100.64.0.10:8092
DZN_PLAYBACK_GLOBAL_CONCURRENCY=8
DZN_PLAYBACK_USER_CONCURRENCY=2
DZN_PLAYBACK_BANDWIDTH_BPS=0
DZN_PLAYBACK_TICKET_TTL=120
DZN_PLAYBACK_CHUNK_BYTES=262144
