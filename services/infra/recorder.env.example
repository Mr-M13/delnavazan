# /etc/delnavazan/recorder.env — root-only, mode 0600. Never place under a web root.
DZN_RECORDER_SERVICE_ID=ovh-recorder-1
DZN_RECORDER_DATABASE_DSN=pgsql:host=127.0.0.1;port=5432;dbname=delnavazan_recording
DZN_RECORDER_DATABASE_USER=delnavazan_recorder
DZN_RECORDER_DATABASE_PASSWORD=REPLACE_WITH_DATABASE_SECRET
DZN_RECORDING_ROOT=/srv/delnavazan-recordings
DZN_ARCHIVE_ROOT=/mnt/mbox/DelnavazanRecordings
DZN_ARCHIVE_MOUNT_MARKER=/mnt/mbox/.delnavazan-mount
DZN_ARCHIVE_NODE_IDENTITY=REPLACE_WITH_PIXELBOX_MOUNT_IDENTITY
DZN_ARCHIVE_TRANSPORT=rsync
DZN_ARCHIVE_SSH_HOST=pixelbox.tailnet-name.ts.net
DZN_ARCHIVE_SSH_USER=delnavazan-archive
DZN_ARCHIVE_SSH_KEY=/etc/delnavazan/keys/archive_ed25519
DZN_ARCHIVE_RSYNC_BINARY=/usr/bin/rsync
DZN_WORDPRESS_BASE_URL=https://delnavazan.com
DZN_RECORDING_SERVICE_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
DZN_RECORDING_SERVICE_KEY_ID=dzn-recorder-v1
DZN_MBOX_CONFIRMATION_SECRET=REPLACE_WITH_A_DIFFERENT_32_BYTE_SECRET
DZN_LIVEKIT_API_URL=https://rtc.delnavazan.com
DZN_LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_KEY
DZN_LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_SECRET
DZN_EGRESS_TEMPLATE_URL=http://127.0.0.1:8091/egress/template
DZN_EGRESS_LAYOUT=dzn-two-person
DZN_RECORDER_MIN_FREE_BYTES=5368709120
DZN_RECORDER_MIN_FREE_PERCENT=10
DZN_ARCHIVE_MIN_FREE_BYTES=1073741824
DZN_RECORDER_LEASE_SECONDS=300
DZN_RECORDER_MAX_ATTEMPTS=8
DZN_RECORDER_HTTP_BIND=127.0.0.1:8091
DZN_TAILSCALE_BINARY=/usr/bin/tailscale
# Never set CAPTURE_ENABLED/RESEARCH_EXPORT_ENABLED or a production capture override here.
